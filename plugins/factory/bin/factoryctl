#!/usr/bin/env python3
"""Software Factory engine CLI. Runs on the system Python (>= 3.9); no third-party packages."""

import os
import sys

if sys.version_info < (3, 9):
    sys.stderr.write("factoryctl needs Python 3.9 or newer (found %d.%d)\n" % sys.version_info[:2])
    sys.exit(2)

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from factory_core.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
